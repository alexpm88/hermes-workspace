# Hermes Workspace + LM Studio Configuration
# This is a ready-to-use .env file for local LM Studio development

# ═══════════════════════════════════════════════════════════════
# LM STUDIO CONFIGURATION (Local LLM on port 1234)
# ═══════════════════════════════════════════════════════════════

# Use LM Studio's OpenAI-compatible API endpoint
# LM Studio serves all API calls through port 1234
# This variable is used by integrations that expect OpenAI-like endpoints
OLLAMA_API_BASE=http://localhost:1234/v1

# Alternative endpoint configuration (for custom integrations)
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_MODEL=qwen2.5-coder-3b-instruct-abliterated

# Model-specific parameters
LM_STUDIO_TEMPERATURE=0.1
LM_STUDIO_MAX_TOKENS=-1
LM_STUDIO_TOP_P=0.95

# ═══════════════════════════════════════════════════════════════
# WORKSPACE SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Workspace web server
PORT=3002
HOST=127.0.0.1

# Development mode
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════
# OPTIONAL: Hermes Agent Gateway (for multi-agent features)
# ═══════════════════════════════════════════════════════════════

# Leave commented out for local-only development
# To enable: Install hermes-agent and run 'hermes gateway run' in another terminal

# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_TOKEN=

# ═══════════════════════════════════════════════════════════════
# SECURITY (Optional)
# ═══════════════════════════════════════════════════════════════

# Add password protection if exposing beyond localhost
# HERMES_PASSWORD=your-strong-32-character-password-here

# ═══════════════════════════════════════════════════════════════
# ADVANCED: LLM Provider Keys (not needed for LM Studio local mode)
# ═══════════════════════════════════════════════════════════════

# If you want to use cloud LLM providers alongside local LM Studio:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# ═══════════════════════════════════════════════════════════════
# TELEMETRY & ANALYTICS (Optional)
# ═══════════════════════════════════════════════════════════════

# Disable HermesWorld multiplayer hub (local-only development)
VITE_HERMESWORLD_ENABLED=0

# Keep debug logging disabled in development
DEBUG=
